---
const links=[['/','Home'],['/research/','Research'],['/people/','People'],['/publications/','Publications'],['/news/','News'],['/contact/','Contact']];
---
<header class="header"><div class="container nav"><a class="brand" href="/" aria-label="van der Pol Group home"><span class="mark" aria-hidden="true">⬡</span><span><strong>van der Pol Group</strong><small>OPTOELECTRONIC MIXED CONDUCTORS</small></span></a><button class="menu" aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-nav">☰</button><nav id="main-nav" aria-label="Main navigation">{links.map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav></div></header>
<style>.header{background:#fff;position:sticky;top:0;z-index:10;border-bottom:1px solid #e6edf1}.nav{min-height:76px;display:flex;justify-content:space-between;align-items:center;gap:20px}.brand{display:flex;align-items:center;gap:12px}.brand strong{display:block;font-size:1.23rem;line-height:1.1}.brand small{display:block;font-size:.58rem;letter-spacing:.1em;font-weight:750;margin-top:4px}.mark{font-size:2.9rem;line-height:1;color:#0696a6}nav{display:flex;align-items:center;gap:23px}nav a{font-size:.87rem;font-weight:650;padding:27px 0 23px;border-bottom:3px solid transparent}nav a[aria-current=page]{color:#078a99;border-color:#078a99}.menu{display:none;background:transparent;border:0;font-size:1.7rem;color:#102a43}@media(max-width:820px){.menu{display:block}nav{display:none;position:absolute;top:76px;left:0;right:0;background:white;box-shadow:0 10px 15px #102a4315;padding:15px 25px;flex-direction:column;align-items:stretch;gap:0}nav.open{display:flex}nav a{padding:12px;border:0}.brand strong{font-size:1.05rem}.brand small{font-size:.48rem}}</style>
<script>const btn=document.querySelector<HTMLButtonElement>('.menu');const nav=document.querySelector<HTMLElement>('#main-nav');btn?.addEventListener('click',()=>{const open=nav?.classList.toggle('open')??false;btn.setAttribute('aria-expanded',String(open));});</script>
