
---
const links = [
  ['/', 'Home'],
  ['/research/', 'Research'],
  ['/people/', 'People'],
  ['/publications/', 'Publications'],
  ['/news/', 'News'],
  ['/contact/', 'Contact']
];
---

<header class="header">
  <div class="container nav">

    <!-- OMC logo and group name on the left -->
    <a class="brand" href="/" aria-label="van der Pol Group home">
      <img
        src="/images/omc-logo.png"
        alt=""
        class="brand-logo"
      />
      <span class="brand-text">
        <strong>van der Pol Group</strong>
        <small>OPTOELECTRONIC MIXED CONDUCTORS</small>
      </span>
    </a>

    <!-- Navigation links on the right -->
    <nav id="main-nav" aria-label="Main navigation">
      {links.map(([href, label]) => (
        <a
          href={href}
          aria-current={Astro.url.pathname === href ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Mobile navigation button -->
    <button
      class="menu"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      ☰
    </button>

  </div>
</header>

<style>
  .header {
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid #e6edf1;
  }

  .nav {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand-logo {
    width: 85px;
    height: auto;
    display: block;
    flex-shrink: 0;
  }

  /* Group name in teal */
  .brand-text strong {
    display: block;
    font-size: 1.23rem;
    line-height: 1.1;
    color: #0696a6;
  }

  .brand-text small {
    display: block;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    font-weight: 750;
    margin-top: 4px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 23px;
    margin-left: auto;
  }

  nav a {
    font-size: 0.87rem;
    font-weight: 650;
    padding: 27px 0 23px;
    border-bottom: 3px solid transparent;
  }

  nav a[aria-current="page"] {
    color: #078a99;
    border-color: #078a99;
  }

  .menu {
    display: none;
    background: transparent;
    border: 0;
    font-size: 1.7rem;
    color: #102a43;
    cursor: pointer;
  }

  @media (max-width: 1100px) {
    nav {
      gap: 12px;
    }

    .brand-logo {
      width: 70px;
    }

    .brand-text strong {
      font-size: 1.05rem;
    }
  }

  @media (max-width: 900px) {
    .menu {
      display: block;
      margin-left: auto;
    }

    nav {
      display: none;
      position: absolute;
      top: 76px;
      left: 0;
      right: 0;
      background: white;
      box-shadow: 0 10px 15px #102a4315;
      padding: 15px 25px;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    nav.open {
      display: flex;
    }

    nav a {
      padding: 12px;
      border: 0;
    }

    .brand-text small {
      font-size: 0.48rem;
    }
  }

  @media (max-width: 480px) {
    .nav {
      gap: 8px;
    }

    .brand {
      gap: 8px;
      min-width: 0;
    }

    .brand-logo {
      width: 55px;
    }

    .brand-text strong {
      font-size: 0.9rem;
    }

    .brand-text small {
      font-size: 0.38rem;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu');
  const nav = document.querySelector<HTMLElement>('#main-nav');

  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
