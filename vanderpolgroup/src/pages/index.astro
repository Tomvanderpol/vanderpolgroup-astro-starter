---
import BaseLayout from '../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const research=(await getCollection('research')).sort((a,b)=>a.data.order-b.data.order);
const news=(await getCollection('news')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
const pubs=(await getCollection('publications')).filter(p=>p.data.featured).sort((a,b)=>b.data.year-a.data.year).slice(0,3);
---
<BaseLayout title="Home"><section class="hero"><div class="container hero-content"><span class="eyebrow">VAN DER POL GROUP</span><h1>Bridging ions,<br/>electrons and <em>light.</em></h1><p>Exploring organic mixed ionic–electronic conductors, organic electronics, and light-responsive materials and devices.</p><div class="actions"><a class="btn" href="/research/">Our research →</a><a class="btn secondary" href="/people/">Meet the group</a></div></div></section><section class="section soft"><div class="container"><div class="intro"><div><div class="eyebrow">RESEARCH FOCUS</div><h2>Our research areas</h2></div><p>Developing techniques, understanding materials and mechanisms, and exploring the interaction of light with mixed conduction.</p></div><div class="cards">{research.map((item,i)=><a class="card research" href={`/research/${item.id}/`}><div class="symbol">{['⚙','◇','✺'][i%3]}</div><h3>{item.data.title}</h3><p>{item.data.summary}</p><span class="more">Explore research →</span></a>)}</div></div></section><section class="section"><div class="container grid-two about"><div class="image"><img src="/images/hero-original.png" alt="Conceptual visualization of an illuminated organic mixed conductor between electrodes" loading="lazy"/></div><div><div class="eyebrow">ABOUT US</div><h2>The van der Pol Group</h2><p>We investigate organic mixed ionic–electronic conductors and organic electronics, connecting experimental techniques, material mechanisms, and emerging optoelectronic functionalities.</p><p class="muted">Our research explores how ions, electrons, and light interact in organic materials and devices.</p><a class="btn" href="/people/">Meet the group →</a></div></div></section><section class="section soft"><div class="container grid-two"><div><div class="section-title"><h2>Latest news</h2><a href="/news/">All news →</a></div>{news.length?news.map(n=><div class="item"><small>{n.data.date.toLocaleDateString('en-GB',{year:'numeric',month:'long',day:'numeric'})}</small><h3><a href={`/news/${n.id}/`}>{n.data.title}</a></h3><p class="muted">{n.data.summary}</p></div>):<p class="muted">News will appear here once published.</p>}</div><div><div class="section-title"><h2>Selected publications</h2><a href="/publications/">All publications →</a></div>{pubs.length?pubs.map(p=><div class="item"><h3>{p.data.doi?<a href={`https://doi.org/${p.data.doi}`} target="_blank" rel="noopener noreferrer">{p.data.title} ↗</a>:p.data.title}</h3><p class="muted">{p.data.authors}</p><small>{p.data.journal} {p.data.year}</small></div>):<p class="muted">Selected publications will appear here once added.</p>}</div></div></section></BaseLayout>
<style>.hero{min-height:480px;display:flex;align-items:center;background:linear-gradient(90deg,#071c35 0%,#071c35f5 28%,#071c35a8 48%,#071c3500 83%),url('/images/hero-original.png') right center/auto 100% no-repeat,#081b35;color:white}.hero-content{padding:65px 0}.hero h1{margin:18px 0}.hero em{color:#27c4d3;font-style:normal}.hero p{max-width:490px;font-size:1.08rem}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.hero .eyebrow{color:#42d0d7}.intro{display:flex;align-items:end;justify-content:space-between;gap:35px;margin-bottom:26px}.intro h2{margin:8px 0 0}.intro p{max-width:450px;color:#526b7c;margin:0}.symbol{width:55px;height:55px;border-radius:50%;display:grid;place-items:center;background:#0a98a5;color:white;font-size:2rem;margin-bottom:22px}.research:nth-child(2) .symbol{background:#7359d6}.research:nth-child(3) .symbol{background:#e99a19}.research{transition:transform .2s,box-shadow .2s}.research:hover{transform:translateY(-3px);box-shadow:0 12px 30px #102a431b}.more{font-weight:700;color:#078a99;font-size:.88rem}.about{align-items:center}.image img{height:310px;width:100%;object-fit:cover;border-radius:12px}.section-title{display:flex;align-items:center;justify-content:space-between;gap:12px}.section-title h2{margin-bottom:12px}.section-title a{color:#078a99;font-size:.85rem;font-weight:700}.item small{color:#078a99}@media(max-width:760px){.hero{min-height:520px;background:linear-gradient(90deg,#071c35ed,#071c35bb),url('/images/hero-original.png') center/cover}.intro{display:block}.intro p{margin-top:12px}.image img{height:240px}}</style>
