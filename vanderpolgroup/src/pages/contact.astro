
---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
  <section class="pagehead">
    <div class="container">
      <h1>Get in Touch</h1>
      <p class="muted">
        Interested in our research, collaboration, or joining the group?
        We'd be happy to hear from you.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-content">

      <h2 class="group-heading">
        van der Pol Group
        <span class="separator">—</span>
        <span class="group-subtitle">
          Optoelectronic Mixed Conductors
        </span>
      </h2>

      <div class="contact-details">

        <div class="contact-item">
          <h3>Contact person</h3>
          <p>Tom van der Pol, Assistant Professor</p>
        </div>

        <div class="contact-item">
          <h3>Email</h3>
          <p>t.p.a.v.d.pol[@]tue.nl</p>
        </div>

        <div class="contact-item">
          <h3>Office</h3>
          <p>STW 4.27</p>
        </div>

        <div class="contact-item">
          <h3>Affiliation</h3>
          <p>
            Department of Chemical Engineering and Chemistry<br />
            Eindhoven University of Technology (TU/e)
          </p>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Main contact content */
  .contact-content {
    max-width: 1000px;
  }

  /* Group name and research area */
  .group-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0 0 1.6rem;
    font-size: 1.5rem;
    line-height: 1.4;
  }

  .separator {
    color: #0696a6;
  }

  .group-subtitle {
    font-size: 1.1rem;
    font-weight: 400;
    color: #64748b;
  }

  /* Contact details */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item h3 {
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #0696a6;
  }

  .contact-item p {
    margin: 0;
    line-height: 1.5;
  }

  /* Mobile adjustments */
  @media (max-width: 600px) {
    .group-heading {
      font-size: 1.3rem;
    }

    .group-subtitle {
      font-size: 1rem;
    }
  }
</style>
