
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Current team members
const people = (await getCollection('people')).sort(
  (a, b) => a.data.order - b.data.order
);

// Former group members
const alumni = (await getCollection('alumni')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="The Team">
  <section class="pagehead">
    <div class="container">
      <h1>The Team</h1>
      <p class="muted">
        Meet the researchers behind the van der Pol Group.
      </p>
    </div>
  </section>

  <!-- Current team members -->
  <section class="section">
    <div class="container">
      {people.length ? (
        <div class="cards">
          {people.map((person) => (
            <a
              class="card person-card"
              href={`/people/${person.id}/`}
            >
              {person.data.image && (
                <img
                  src={person.data.image}
                  alt={person.data.name}
                  loading="lazy"
                  class="person-image"
                />
              )}

              <div class="person-info">
                <h2>{person.data.name}</h2>
                <p class="role">{person.data.role}</p>
                <span class="profile-link">
                  View profile →
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="muted">
          Team profiles are being prepared.
          Add members through Pages CMS.
        </p>
      )}
    </div>
  </section>

  <!-- Alumni section -->
  <section class="section alumni-section">
    <div class="container">
      <h2>Alumni</h2>
      <p class="muted alumni-intro">
        Former members of the van der Pol Group.
      </p>

      {alumni.length > 0 ? (
        <div class="alumni-table-wrapper">
          <table class="alumni-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Position in the group</th>
                <th>Next position</th>
              </tr>
            </thead>

            <tbody>
              {alumni.map((person) => (
                <tr>
                  <td>{person.data.name}</td>
                  <td>{person.data.position}</td>
                  <td>{person.data.nextPosition}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="muted alumni-empty">
          Alumni information will be added soon.
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* Team member cards */

  .person-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    text-decoration: none;
    color: inherit;
  }

  .person-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .person-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .person-info h2 {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
  }

  .role {
    margin: 0 0 1.2rem;
    color: #64748b;
  }

  .profile-link {
    margin-top: auto;
    color: #0696a6;
    font-weight: 600;
  }

  .person-card:hover .profile-link {
    text-decoration: underline;
  }

  /* Alumni section */

  .alumni-section {
    padding-top: 0;
  }

  .alumni-section h2 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }

  .alumni-intro {
    margin-bottom: 2rem;
  }

  .alumni-table-wrapper {
    width: 100%;
    overflow-x: auto;
  }

  .alumni-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .alumni-table th {
    color: #0696a6;
    font-weight: 600;
    padding: 1rem;
    border-bottom: 2px solid #dce5e9;
  }

  .alumni-table td {
    padding: 1rem;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: top;
  }

  .alumni-table tbody tr:hover {
    background-color: #f8fafc;
  }

  .alumni-empty {
    margin-top: 1rem;
  }

  @media (max-width: 700px) {
    .alumni-table {
      min-width: 550px;
    }

    .alumni-section h2 {
      font-size: 1.7rem;
    }
  }
</style>
