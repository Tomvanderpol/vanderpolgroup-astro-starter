
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const people = (await getCollection('people')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="The Team">
  <section class="pagehead">
    <div class="container">
      <h1>The Team</h1>
      <p class="muted">
        Meet the researchers behind the van der Pol Group.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {people.length ? (
        <div class="cards">
          {people.map((person) => (
            <a
              class="card person-card"
              href={`/people/${person.id}/`}
            >
              {person.data.image && (
                <img
                  src={person.data.image}
                  alt={person.data.name}
                  loading="lazy"
                  class="person-image"
                />
              )}

              <div class="person-info">
                <h2>{person.data.name}</h2>
                <p class="role">{person.data.role}</p>
                <span class="profile-link">
                  View profile →
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="muted">
          Team profiles are being prepared.
          Add members through Pages CMS.
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .person-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    text-decoration: none;
    color: inherit;
  }

  .person-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .person-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .person-info h2 {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
  }

  .role {
    margin: 0 0 1.2rem;
    color: #64748b;
  }

  .profile-link {
    margin-top: auto;
    color: #0696a6;
    font-weight: 600;
  }

  .person-card:hover .profile-link {
    text-decoration: underline;
  }
</style>
